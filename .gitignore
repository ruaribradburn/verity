# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Python venv (bun run setup:trafilatura)
.venv/

# dependencies (root and all workspaces)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (root and packages, e.g. packages/web)
.next/
out/

# production
/build

# local graph DB (SQLite)
/data/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.codex
reference
node_modules

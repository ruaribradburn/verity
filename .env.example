# Copy to `.env` at the repo root and adjust for your machine.
# Never commit `.env` — it may contain secrets (e.g. API keys).

# --- Ports (must differ: web UI vs API) ---
WEB_PORT=3000
API_PORT=3001

# --- Origins (no trailing slashes) ---
# Comma-separated list of browser origins allowed to call the API (CORS).
# Include both hostname styles if you switch between localhost and 127.0.0.1.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Base URL the Next.js server uses to reach the API (server-side only; not exposed to the browser).
API_ORIGIN=http://127.0.0.1:3001

# Only set if the browser must call the API directly (e.g. client components).
# Prefer same-origin / route handlers in production so this stays empty or points at a public API URL.
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:3001

# Example server-side secret (never prefix with NEXT_PUBLIC_)
# GEMINI_KEY=
